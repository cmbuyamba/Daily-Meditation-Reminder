# Environment Variables for Microsoft 365 Integration
# Copy this file to .env.local and fill in your values

# Azure AD Application Registration
# Get these values from Azure Portal > Azure Active Directory > App Registrations
REACT_APP_AZURE_CLIENT_ID=your-client-id-here
REACT_APP_AZURE_TENANT_ID=your-tenant-id-here

# Redirect URI (should match the one registered in Azure AD)
REACT_APP_REDIRECT_URI=http://localhost:3000

# SharePoint Configuration
# Format: yourdomain.sharepoint.com:/sites/sitename
REACT_APP_SHAREPOINT_SITE_URL=yourdomain.sharepoint.com:/sites/naacus

# SharePoint List IDs
# Get these from SharePoint > List Settings > URL (look for List=%7B...%7D)
REACT_APP_MEMBERSHIP_LIST_ID=your-membership-list-id-here
REACT_APP_VOLUNTEER_LIST_ID=your-volunteer-list-id-here

# Optional: OneDrive Excel File IDs (if using Excel instead of SharePoint Lists)
# REACT_APP_MEMBERSHIP_FILE_ID=your-membership-excel-file-id
# REACT_APP_VOLUNTEER_FILE_ID=your-volunteer-excel-file-id
